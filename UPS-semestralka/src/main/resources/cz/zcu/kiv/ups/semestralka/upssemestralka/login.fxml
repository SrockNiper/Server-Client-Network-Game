<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20" xmlns:fx="http://javafx.com/fxml"
      fx:controller="cz.zcu.kiv.ups.semestralka.upssemestralka.LoginController"
      prefWidth="400" prefHeight="300">

    <padding>
        <Insets top="30" right="50" bottom="30" left="50"/>
    </padding>

    <Label text="Přihlášení do hry"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <VBox alignment="CENTER" spacing="15">
        <Label text="Zadejte svou přezdívku:"
               style="-fx-font-size: 14px;"/>

        <TextField fx:id="nicknameField"
                   promptText="Přezdívka"
                   prefWidth="200"
                   style="-fx-font-size: 14px;"/>
        <TextField fx:id="serverIPField"
                   promptText="Adresa serveru"
                   prefWidth="200"
                   style="-fx-font-size: 14px;"/>
        <TextField fx:id="serverPortField"
                   promptText="Port serveru"
                   prefWidth="200"
                   style="-fx-font-size: 14px;"/>

        <Button fx:id="loginButton"
                text="Přihlásit se"
                onAction="#onLogin"
                prefWidth="120"
                prefHeight="35"
                style="-fx-font-size: 14px; -fx-background-color: #4CAF50; -fx-text-fill: white;"/>
    </VBox>

    <Label fx:id="errorLabel"
           textFill="red"
           style="-fx-font-size: 12px;"
           visible="false"/>
</VBox>

