<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Button?>

<VBox alignment="CENTER" xmlns:fx="http://javafx.com/fxml"
      fx:controller="cz.zcu.kiv.ups.semestralka.upssemestralka.LobbyController"
      prefWidth="500" prefHeight="400"
      spacing="20"
      style="-fx-padding: 20;">

    <Label text="Herní Lobby"
           style="-fx-font-size: 2.5em; -fx-font-weight: bold;"/>

    <Label text="Vyberte herní místnost:"
           style="-fx-font-size: 1.2em;"/>

    <ListView fx:id="roomListView"
              prefWidth="400"
              prefHeight="200"
              VBox.vgrow="ALWAYS"/>

    <Button fx:id="createButton"
            text="Vytvořit novou místnost"
            onAction="#onCreateRoom"
            prefWidth="200"
            style="-fx-font-size: 1.1em; -fx-padding: 8 16 8 16; -fx-background-color: #4CAF50; -fx-text-fill: white;"/>

    <Button fx:id="joinButton"
            text="Vstoupit do místnosti"
            onAction="#onJoinRoom"
            prefWidth="200"
            disable="true"
            style="-fx-font-size: 1.1em; -fx-padding: 8 16 8 16;"/>

</VBox>

